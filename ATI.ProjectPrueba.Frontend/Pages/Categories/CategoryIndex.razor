@page "/categories"

<h3>Categorias</h3>

<div class="nb-3">
	<a class="btn btn-primary" href="/categories/create"> Nueva Categoria</a>
</div>

<GenericList MyList="Categories">
	
	<Body>
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Categorias</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var category in Categories!)
				{
					<tr>
						<td>@category.Name</td>
						<td>
							<a href="/categories/edit/@category.ID" class=" btn btn-warning"> Editar </a>
							<button type="button" @onclick=@(() => DeleteAsync(category)) class=" btn btn-danger">Borrar</button>
						</td>
					</tr>
				}

			</tbody>
		</table>

	</Body>
</GenericList>



